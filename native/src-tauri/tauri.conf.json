{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Golos",
  "version": "0.1.0",
  "identifier": "com.golos.transcription",
  "build": {
    "beforeDevCommand": "npm run native:dev",
    "beforeBuildCommand": "npm run native:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Golos", "width": 1180, "height": 780, "minWidth": 760, "minHeight": 560 }],
    "security": {
      "assetProtocol": { "enable": true },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": ["app"], "category": "Productivity", "shortDescription": "Transcribe audio privately on your device", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
