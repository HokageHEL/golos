{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Golos",
  "version": "0.1.0",
  "identifier": "com.golos.transcription",
  "build": {
    "windows": { "staticVCRuntime": false },
    "beforeDevCommand": "npm run native:dev",
    "beforeBuildCommand": "npm run native:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Golos", "width": 1180, "height": 780, "minWidth": 760, "minHeight": 560 },
      { "label": "overlay", "title": "Golos Dictation", "url": "index.html?overlay=1", "width": 380, "height": 220, "resizable": false, "decorations": false, "transparent": true, "visible": false, "focus": false, "alwaysOnTop": true, "skipTaskbar": true, "shadow": true }
    ],
    "security": {
      "assetProtocol": { "enable": true },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "macOS": { "minimumSystemVersion": "13.3" }, "active": true, "targets": ["app"], "category": "Productivity", "shortDescription": "Transcribe audio privately on your device", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
