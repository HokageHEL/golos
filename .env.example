# Copy to .env.local for Next.js. Never commit real credentials.
# NEXT_PUBLIC_* values are public and embedded at build time; rebuild after changes.

# REQUIRED: Supabase Project Settings > API. Local: npx supabase start.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public anon/publishable key (safe in browsers; RLS enforces ownership).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service_role/secret key; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED in production: canonical HTTPS origin, without a trailing slash.
# Local callbacks and auth allow-list must use this exact host and port.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# REQUIRED for real transcription: AssemblyAI dashboard API key.
# Blank selects the canned provider ONLY in npm run dev/test, never production.
ASSEMBLYAI_API_KEY=
# REQUIRED with real transcription: generate an independent random secret,
# e.g. openssl rand -hex 32. Sent as x-golos-webhook-secret by AssemblyAI.
ASSEMBLYAI_WEBHOOK_SECRET=

# REQUIRED for anonymous trials: Upstash Redis database REST URL and token.
# Local docker compose: URL http://localhost:8079; token local-dev-token.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token
# REQUIRED for anonymous trials: matching Cloudflare Turnstile site/secret keys.
# Below are public test keys; replace BOTH for a live domain.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# REQUIRED for paid launch: Polar organization token with checkout, subscription,
# and customer-session permissions. Use separate sandbox credentials for testing.
POLAR_ACCESS_TOKEN=
# Polar webhook endpoint signing secret. Subscribe to order.paid and subscription.*.
POLAR_WEBHOOK_SECRET=
# One-time USD products for credit. Disable discounts and configure exact prices.
# Format: 1000:PRODUCT_UUID,2500:PRODUCT_UUID,5000:PRODUCT_UUID ($10/$25/$50).
POLAR_TOPUP_PRODUCTS=
# Monthly recurring USD $9 product granting 300 minutes. No trial or metered prices.
POLAR_SUBSCRIPTION_PRODUCT_ID=
# sandbox for testing; production for real purchases. Never mix credentials.
POLAR_SERVER=sandbox

# REQUIRED for reconciliation: random secret (openssl rand -hex 32).
# Scheduler GET /api/cron/reconcile every 5 minutes with Authorization: Bearer SECRET.
CRON_SECRET=

# OPTIONAL: show Google login only after enabling/configuring it in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# OPTIONAL local CLI only: export these in your shell before supabase start.
# Google Cloud OAuth redirect: http://127.0.0.1:54321/auth/v1/callback locally,
# or https://PROJECT.supabase.co/auth/v1/callback when hosted.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
