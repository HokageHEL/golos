{
  "name": "golos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run native:app",
    "build": "npm run native:build",
    "lint": "eslint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "native:dev": "vite native",
    "native:build": "tsc -p native/tsconfig.json && vite build native",
    "native:check": "tsc -p native/tsconfig.json",
    "native:app": "cd native && tauri dev",
    "native:bundle": "cd native && tauri build",
    "native:test": "cargo test --manifest-path native/src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
