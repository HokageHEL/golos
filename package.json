{
  "name": "golos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:smoke": "node scripts/smoke-local.mjs",
    "native:dev": "vite native",
    "native:build": "tsc -p native/tsconfig.json && vite build native",
    "native:check": "tsc -p native/tsconfig.json",
    "native:app": "cd native && tauri dev",
    "native:bundle": "cd native && tauri build",
    "native:test": "cargo test --manifest-path native/src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@polar-sh/sdk": "^0.49.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tauri-apps/api": "^2.12.4",
    "@upstash/redis": "^1.38.2",
    "docx": "^9.7.1",
    "next": "^16.3.5",
    "next-intl": "^4.13.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "supabase": "^2.113.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
